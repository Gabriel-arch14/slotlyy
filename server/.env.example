# Копирай този файл като .env и попълни стойностите. .env НЕ се качва в GitHub.

# Ключ от https://resend.com/api-keys (за имейлите при поръчка)
RESEND_API_KEY=

# Фирменият имейл — получава известие за всяка нова поръчка
SHOP_EMAIL=

# Подател. Без потвърден домейн в Resend може да е само onboarding@resend.dev
MAIL_FROM=Slotlyy <onboarding@resend.dev>

# Таен ключ за входовете. Генерирай с:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Паролата за вход в /admin (имейл admin@slotlyy.bg)
ADMIN_PASSWORD=

# По желание: фиксиран адрес на сайта за линковете в имейлите.
# Ако е празно, се ползва адресът, от който е дошла поръчката.
# SITE_URL=https://example.com
